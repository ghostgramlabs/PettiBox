{
  "manifest_version": 3,
  "name": "PettiBox",
  "short_name": "PettiBox",
  "version": "0.2.0",
  "description": "Save pages to PettiBox and search your library. Syncs with the PettiBox app through your own Google Drive.",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PettiBox",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "identity",
    "storage",
    "unlimitedStorage",
    "alarms",
    "contextMenus",
    "activeTab",
    "favicon"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "785489867134-pedrhdknqvdd1jnleki69kj9nsa8eo7g.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  },
  "minimum_chrome_version": "120",
  "commands": {
    "save-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Save this page to PettiBox"
    }
  }
}
